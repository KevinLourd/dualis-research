{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dualis-console",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  "observability": { "enabled": true },
  // Run next to Neon (aws-us-east-1): a page makes up to ~30 reads, each a round trip to the database. At the edge
  // that was ~180 ms per wave of 6 (Analysis page ~1.1 s); here a read takes a few ms (Kevin 2026-11-06: "make it instant").
  "placement": { "region": "aws:us-east-1" }
  // Runtime secrets (set by .github/workflows/deploy.yml): DATABASE_URL, CLERK_SECRET_KEY.
}
