{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "drizzle-orm": [
        "./node_modules/drizzle-orm"
      ],
      "drizzle-orm/*": [
        "./node_modules/drizzle-orm/*"
      ],
      "@/*": [
        "../web/src/*"
      ],
      "@anthropic-ai/claude-agent-sdk": [
        "./node_modules/@anthropic-ai/claude-agent-sdk"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
